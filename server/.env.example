MONGO_URI=
# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Email option 1 (local development): Gmail SMTP with a Gmail App Password
EMAIL_USER=@gmail.com
EMAIL_PASS=
# Email option 2 (hosts that block SMTP, e.g. Render free plan): Brevo HTTPS API.
# When BREVO_API_KEY is set it is used instead of Gmail. EMAIL_FROM must be a sender
# verified in Brevo (defaults to EMAIL_USER).
# BREVO_API_KEY=
# EMAIL_FROM=you@gmail.com
# EMAIL_FROM_NAME=BookEven
PORT=5000
# Frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173
# Optional: token lifetime (default 30d)
# JWT_EXPIRES_IN=7d
# Optional: set when running behind a reverse proxy, e.g. 1
# TRUST_PROXY=1
