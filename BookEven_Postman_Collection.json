{
    "info": {
        "_postman_id": "c7a8b29e-4c5d-4a1v-b3nf-9a8x7b6c5d4e",
        "name": "BookEven APIs",
        "description": "Every BookEven API endpoint. Set base_url, run \"Login (admin)\" and \"Login (user)\" first; tokens and ids are saved into collection variables automatically. Codes (OTP) arrive by email; paste them into the request bodies.",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Auth",
            "item": [
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"name\": \"Test User\",\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/register",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "register"
                            ]
                        },
                        "description": "Creates an unverified account and emails a 6-digit code. Password: 8-128 characters. 503 with accountCreated: true if the email could not be sent (use Resend code)."
                    }
                },
                {
                    "name": "Verify code",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set('user_token', pm.response.json().token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"test@example.com\",\n    \"otp\": \"123456\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/verify-otp",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "verify-otp"
                            ]
                        },
                        "description": "Verifies the account with the emailed code and returns a token (saved as user_token). Codes last 5 minutes and allow 5 attempts."
                    }
                },
                {
                    "name": "Resend code",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"test@example.com\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/resend-otp",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "resend-otp"
                            ]
                        },
                        "description": "Emails a new verification code. 429 with retryAfterSeconds if one was sent less than 60 seconds ago. The reply is the same for unknown or already verified accounts."
                    }
                },
                {
                    "name": "Login (user)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set('user_token', pm.response.json().token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"user@bookeven.com\",\n    \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Returns a token valid for 7 days (saved as user_token). 403 needsVerification for unverified accounts (a code is emailed)."
                    }
                },
                {
                    "name": "Login (admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 200) {",
                                    "    pm.collectionVariables.set('admin_token', pm.response.json().token);",
                                    "}"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "noauth"
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"email\": \"admin@bookeven.com\",\n    \"password\": \"password123\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/auth/login",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "auth",
                                "login"
                            ]
                        },
                        "description": "Seeded admin account (development only). Token saved as admin_token."
                    }
                }
            ]
        },
        {
            "name": "Events",
            "item": [
                {
                    "name": "List upcoming events",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "const events = pm.response.json();",
                                    "if (events.length) pm.collectionVariables.set('event_id', events[0]._id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "noauth"
                        },
                        "url": {
                            "raw": "{{base_url}}/events?when=upcoming&search=&category=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "events"
                            ],
                            "query": [
                                {
                                    "key": "when",
                                    "value": "upcoming",
                                    "description": "upcoming (soonest first), past, or all (default)"
                                },
                                {
                                    "key": "search",
                                    "value": "",
                                    "description": "title contains (optional)"
                                },
                                {
                                    "key": "category",
                                    "value": "",
                                    "description": "exact category (optional)"
                                }
                            ]
                        }
                    }
                },
                {
                    "name": "Get event",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "noauth"
                        },
                        "url": {
                            "raw": "{{base_url}}/events/{{event_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "events",
                                "{{event_id}}"
                            ]
                        }
                    }
                },
                {
                    "name": "Create event (admin)",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) pm.collectionVariables.set('event_id', pm.response.json()._id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"title\": \"Tech Conference\",\n    \"description\": \"A conference for developers.\",\n    \"date\": \"2027-03-15T18:30:00.000Z\",\n    \"location\": \"Convention Center\",\n    \"category\": \"Technology\",\n    \"totalSeats\": 100,\n    \"ticketPrice\": 500,\n    \"image\": \"\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/events",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "events"
                            ]
                        },
                        "description": "date must be in the future (ISO 8601, with time). ticketPrice 0 = free. Saves event_id."
                    }
                },
                {
                    "name": "Update event (admin)",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"ticketPrice\": 550,\n    \"totalSeats\": 120\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/events/{{event_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "events",
                                "{{event_id}}"
                            ]
                        },
                        "description": "Send only the fields to change: title, description, date, location, category, totalSeats, ticketPrice, image. totalSeats cannot go below seats already confirmed."
                    }
                },
                {
                    "name": "Delete event (admin)",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/events/{{event_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "events",
                                "{{event_id}}"
                            ]
                        },
                        "description": "Deletes the event, cancels its pending/confirmed bookings (kept as history) and emails those users. Returns cancelledBookings, emailsSent, emailsFailed."
                    }
                }
            ]
        },
        {
            "name": "Bookings (user)",
            "item": [
                {
                    "name": "Send booking code",
                    "request": {
                        "method": "POST",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{user_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/send-otp",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "send-otp"
                            ]
                        },
                        "description": "Emails a 6-digit booking code. Within 60 s of the last one, returns the same message plus retryAfterSeconds and the earlier code stays valid. 503 if the email fails."
                    }
                },
                {
                    "name": "Request a seat",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "type": "text/javascript",
                                "exec": [
                                    "if (pm.response.code === 201) pm.collectionVariables.set('booking_id', pm.response.json().booking._id);"
                                ]
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{user_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"eventId\": \"{{event_id}}\",\n    \"otp\": \"123456\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings"
                            ]
                        },
                        "description": "Creates a pending booking. Fails if the event has started, is sold out, or the user already has a pending/confirmed booking for it. Saves booking_id."
                    }
                },
                {
                    "name": "My bookings",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{user_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/my",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "my"
                            ]
                        },
                        "description": "The caller's own bookings, newest first, for every role."
                    }
                },
                {
                    "name": "Cancel booking",
                    "request": {
                        "method": "DELETE",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{user_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/{{booking_id}}",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "{{booking_id}}"
                            ]
                        },
                        "description": "Owner or admin. A confirmed seat is returned to the event."
                    }
                }
            ]
        },
        {
            "name": "Bookings (admin)",
            "item": [
                {
                    "name": "List all bookings",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings?page=1&limit=20&status=&eventId=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings"
                            ],
                            "query": [
                                {
                                    "key": "page",
                                    "value": "1"
                                },
                                {
                                    "key": "limit",
                                    "value": "20",
                                    "description": "1-100"
                                },
                                {
                                    "key": "status",
                                    "value": "",
                                    "description": "pending | confirmed | rejected | cancelled (optional)"
                                },
                                {
                                    "key": "eventId",
                                    "value": "",
                                    "description": "optional"
                                }
                            ]
                        },
                        "description": "Returns { items, page, limit, total, totalPages }, newest first."
                    }
                },
                {
                    "name": "Booking stats",
                    "request": {
                        "method": "GET",
                        "header": [],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/stats?eventId=",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "stats"
                            ],
                            "query": [
                                {
                                    "key": "eventId",
                                    "value": "",
                                    "description": "optional"
                                }
                            ]
                        },
                        "description": "totalRevenue (confirmed + paid), paidClients, pendingRequests, byStatus, totalBookings."
                    }
                },
                {
                    "name": "Approve booking",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"paymentStatus\": \"paid\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/{{booking_id}}/confirm",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "{{booking_id}}",
                                "confirm"
                            ]
                        },
                        "description": "paymentStatus: 'paid' or 'not_paid'. Takes a seat. emailSent tells whether the confirmation email went out."
                    }
                },
                {
                    "name": "Reject booking",
                    "request": {
                        "method": "PUT",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{admin_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "body": {
                            "mode": "raw",
                            "raw": "{\n    \"reason\": \"Payment not received\"\n}",
                            "options": {
                                "raw": {
                                    "language": "json"
                                }
                            }
                        },
                        "url": {
                            "raw": "{{base_url}}/bookings/{{booking_id}}/reject",
                            "host": [
                                "{{base_url}}"
                            ],
                            "path": [
                                "bookings",
                                "{{booking_id}}",
                                "reject"
                            ]
                        },
                        "description": "Pending bookings only. Reason is optional (max 500 characters) and is shown and emailed to the user."
                    }
                }
            ]
        }
    ],
    "variable": [
        {
            "key": "base_url",
            "value": "http://localhost:5000/api",
            "type": "string"
        },
        {
            "key": "user_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "admin_token",
            "value": "",
            "type": "string"
        },
        {
            "key": "event_id",
            "value": "",
            "type": "string"
        },
        {
            "key": "booking_id",
            "value": "",
            "type": "string"
        }
    ]
}
